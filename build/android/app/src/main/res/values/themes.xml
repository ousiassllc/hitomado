<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WailsApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色はフロントの --accent トークンに揃える（独自の青は使わない。その上の文字は --bone＝app_background）。 -->
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorPrimaryVariant">@color/app_accent</item>
        <item name="colorOnPrimary">@color/app_background</item>
        <!-- システムバーと Window の背景はアプリの背景色に揃える（エッジ・ツー・エッジでは WebView の外側の余白に見える。#87）。 -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
