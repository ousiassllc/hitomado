<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- フロントのトークン bone（ライト）と同じ値（frontend/src/styles/tokens.css）。システムバーの背後・起動直後の背景に使う。ダークは values-night。 -->
    <color name="app_background">#F5F5F4</color>
    <!-- フロントのトークン accent（ライト）と同じ値。Material テーマの主色に使う。ダークは values-night。 -->
    <color name="app_accent">#050505</color>
    <!-- フロントのトークン ink（ライト）と同じ値。致命エラー画面の本文の文字色に使う。ダークは values-night。 -->
    <color name="app_ink">#050505</color>
    <!-- ランチャーアイコン（アダプティブ）の背景。ロゴ v5c の Bone（#f5f5f4）。ダークテーマでも変えない（アイコンは端末のテーマに追従しない。テーマアイコンは monochrome 層が担う）ので values-night には置かない。 -->
    <color name="ic_launcher_background">#f5f5f4</color>
</resources>
