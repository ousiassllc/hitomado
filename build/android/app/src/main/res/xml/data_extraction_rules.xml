<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12（API 31）以降のバックアップ・端末間移行の対象。メール本文を含む DB と、Android Keystore の鍵に紐づく
     暗号化済みの資格情報は、別の端末へ移しても使えない（鍵が復元されない）ため、すべて対象外にする。
     android:allowBackup="false" と同じ意味を、API 31 以降の仕組みでも明示する。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
