<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  .app の Info.plist のひな形（build/config.yml の info から `wails3 update build-assets` が作るものを元にしている）。
  CFBundleVersion・CFBundleShortVersionString は 0.0.0 のままここに置き、リリースの版は
  build/darwin/Taskfile.yml の create:app:bundle が .app 側のコピーへ書き込む（VERSION=X.Y.Z）。
-->
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>Hitomado</string>
        <key>CFBundleDisplayName</key>
        <string>Hitomado</string>
        <key>CFBundleExecutable</key>
        <string>hitomado</string>
        <key>CFBundleIdentifier</key>
        <string>jp.ousias.hitomado</string>
        <key>CFBundleVersion</key>
        <string>0.0.0</string>
        <key>CFBundleShortVersionString</key>
        <string>0.0.0</string>
        <key>CFBundleGetInfoString</key>
        <string>https://github.com/ousiassllc/hitomado</string>
        <key>CFBundleIconFile</key>
        <string>icons</string>
        <key>LSMinimumSystemVersion</key>
        <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
        <true/>
        <key>NSHumanReadableCopyright</key>
        <string>Hitomado contributors, AGPL-3.0</string>
    </dict>
</plist>
