root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# 日本語を含むため BOM 付き UTF-8 が必要（BOM が無いと NSIS・Windows PowerShell 5.1 は ANSI として読む）。
[*.{nsi,ps1}]
charset = utf-8-bom

[*.nsi]
indent_size = 4
